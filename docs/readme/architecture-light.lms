if (!file_exists("build")) { mkdir("build"); }
if (!file_exists("build/rendered")) { mkdir("build/rendered"); }
check = _dsl_ cli="lmpy" install="github:lmctl-ai/lmpy@latest";
let x = mat("1 2 3; 0 1 4; 5 6 0").solve(vec(14.0, 14.0, 17.0));
out.close("example host result", x, vec(1.0, 2.0, 3.0), 0.000000000001);
out.put("solution", x);
end _dsl_
savedsl(check, "build/readme-architecture-check.dslb");
r = system ${dsl_cli(check)} --dsl build/readme-architecture-check.dslb;
if (r.code != 0) { println("lmpy failed: " + trim(r.stderr)); exit(r.code); }
v = json_parse(r.stdout).result.values;
draw = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(1200, 390, "#f5f2eb");
scene.text(54.0, 58.0, 25.0, "From an LMScript block to a checked JSON result", "#182838").set_attr("font-weight", "700");
scene.rect(54.0, 126.0, 236.0, 140.0, "#e5e9e4");
scene.rect(340.0, 126.0, 236.0, 140.0, "#dcebe6");
scene.rect(626.0, 126.0, 236.0, 140.0, "#e2e7ed");
scene.rect(912.0, 126.0, 236.0, 140.0, "#f2e4ca");
scene.text(172.0, 178.0, 20.0, "LMScript source", "#182838").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(172.0, 218.0, 14.0, "typed _dsl_ block", "#536678").set_attr("text-anchor", "middle");
scene.text(458.0, 178.0, 20.0, "lmpy schema", "#182838").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(458.0, 218.0, 14.0, "compile-time API", "#536678").set_attr("text-anchor", "middle");
scene.text(744.0, 178.0, 20.0, "Native engine", "#182838").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(744.0, 218.0, 14.0, "linear algebra + more", "#536678").set_attr("text-anchor", "middle");
scene.text(1030.0, 178.0, 20.0, "JSON result", "#182838").set_attr("text-anchor", "middle").set_attr("font-weight", "700");
scene.text(1030.0, 218.0, 14.0, "checked: " + ${str(v.solution)}, "#536678").set_attr("text-anchor", "middle");
let a = scene.line(296.0, 196.0, 330.0, 196.0, "#a85819", 2.5); a.set_attr("marker-end", "arrow");
let b = scene.line(582.0, 196.0, 616.0, 196.0, "#a85819", 2.5); b.set_attr("marker-end", "arrow");
let c = scene.line(868.0, 196.0, 902.0, 196.0, "#a85819", 2.5); c.set_attr("marker-end", "arrow");
scene.text(54.0, 332.0, 14.0, "The host prints one result line; the script checks the values before continuing.", "#536678");
scene.render_png("build/rendered/readme-architecture-light.png", 1200, 390, 1);
end _dsl_
savedsl(draw, "build/readme-architecture-light.dslb");
r = system ${dsl_cli(draw)} --dsl build/readme-architecture-light.dslb;
if (r.code != 0) { println("lmdraw failed: " + trim(r.stderr)); exit(r.code); }
