// access: read
// Cross-language agreement: a pooled two-sample t-test and a chi-square test of independence in Python and R.
// What it does: on examples/data/tut-groups.csv, (1) the pooled t-test ctrl vs trt2 is the t statistic of the group dummy in a
//   two-group regression in pycli (sm_ols) and t.test(var.equal = TRUE) in R (rcli test_htest); (2) the chi-square test of the 3 x 2
//   group x flowered table uses the statistic computed here and the chi-square survival function from pycli stats_dist against R's
//   chisq.test(correct = FALSE). The statistics are pure arithmetic (tolerance 1e-10 absolute); the p-values come from the t and
//   chi-square distribution functions (scipy vs R's pt / pchisq, tolerance 1e-12 relative), and R's degrees of freedom must equal ours.
// Data: examples/data/tut-groups.csv (seed 104).
// Usage: export PATH=$PWD/bin:$HOME/repos/lmctlhq/rcli/bin:$PATH; lmscript examples/cross-tests.lms   (rcli absent: the R leg is skipped with a hint, exit 0)
import "../cli.schema.dev.json" as pycli;
import "schemas/rcli.cli.schema.v1.json" as rcli;

function check(label, a, b, tol) {
  d = abs(a - b); ok = d <= tol;
  println(sprintf("%-28s %20.12f %20.12f  %-24s %-12s %s", label, a, b, str(d), str(tol), ok ? "ok" : "FAIL"));
  return ok ? 0 : 1;
}
rows = read_csv("examples/data/tut-groups.csv");
w = []; isTrt2 = []; ctrl = []; trt2 = [];
groups = ["ctrl", "trt1", "trt2"]; levels = ["no", "yes"]; table = [[0, 0], [0, 0], [0, 0]];
for (row in rows) {
  table[index_of(groups, row.group)][index_of(levels, row.flowered)] = table[index_of(groups, row.group)][index_of(levels, row.flowered)] + 1;
  if (row.group == "ctrl") { ctrl = concat(ctrl, [row.weight]); w = concat(w, [row.weight]); isTrt2 = concat(isTrt2, [0]); }
  if (row.group == "trt2") { trt2 = concat(trt2, [row.weight]); w = concat(w, [row.weight]); isTrt2 = concat(isTrt2, [1]); }
}
py = pycli.sm_ols({columns: {w: w, trt2: isTrt2}, y: "w", terms: [{var: "trt2"}]});
if (py.status == "simulated") { println("Test agreement simulated."); exit(0); }
if (py.status != "ok" || py.result.status != "OK") { println("pycli sm_ols failed:", json_stringify(py)); exit(1); }
// Chi-square statistic from the table (expected = row total * column total / n).
rsum = [0, 0, 0]; csum = [0, 0]; n = 0;
for (i = 0; i < 3; i = i + 1) { for (j = 0; j < 2; j = j + 1) { rsum[i] = rsum[i] + table[i][j]; csum[j] = csum[j] + table[i][j]; n = n + table[i][j]; } }
x2 = 0; flat = [];
for (i = 0; i < 3; i = i + 1) { for (j = 0; j < 2; j = j + 1) { e = rsum[i] * csum[j] / n; x2 = x2 + (table[i][j] - e) * (table[i][j] - e) / e; flat = concat(flat, [table[i][j]]); } }
pchi = pycli.stats_dist({dist: "chi2", "fn": "sf", params: {df: 2}, x: [x2]});
if (pchi.status != "ok" || pchi.result.status != "OK") { println(json_stringify(pchi)); exit(1); }
if (which("rcli") == null) { println("rcli is not on PATH: R leg skipped (export PATH=$HOME/repos/lmctlhq/rcli/bin:$PATH)"); exit(0); }
rt = rcli.test_htest({test: "t", x: ctrl, y: trt2, var_equal: true});
rc = rcli.test_htest({test: "chisq", x: flat, rows: 3, cols: 2, byrow: true, correct: false});
if (rt.status != "ok" || rc.status != "ok") { println("rcli test_htest failed:", json_stringify([rt, rc])); exit(1); }
c = py.result.coefficients;
println(sprintf("%-28s %20s %20s  %-24s %-12s %s", "quantity", "python", "r", "abs diff", "tolerance", "verdict"));
bad = 0;
// R's t is (mean ctrl - mean trt2) / se; the regression t for the trt2 dummy is (mean trt2 - mean ctrl) / se: compare magnitudes.
bad = bad + check("t statistic |t|", abs(c.statistic[1]), abs(rt.result.statistic), 0.0000000001);
bad = bad + check("t df", py.result.df_resid, rt.result.parameter, 0);
bad = bad + check("t p-value", c.p_value[1], rt.result.p_value, 0.000000000001 * rt.result.p_value);
bad = bad + check("mean difference", c.estimate[1], rt.result.estimate[1] - rt.result.estimate[0], 0.0000000001);
bad = bad + check("chi-square statistic", x2, rc.result.statistic, 0.0000000001);
bad = bad + check("chi-square df", 2, rc.result.parameter, 0);
bad = bad + check("chi-square p-value", pchi.result.values[0], rc.result.p_value, 0.000000000001 * rc.result.p_value);
if (bad > 0) { println(bad, "quantities disagree beyond tolerance"); exit(1); }
println(sprintf("Agreement: pooled t-test (t = %.4f, p = %.5f) and chi-square test (X2 = %.4f, p = %.5f) agree between Python and R.", abs(c.statistic[1]), c.p_value[1], x2, pchi.result.values[0]));
