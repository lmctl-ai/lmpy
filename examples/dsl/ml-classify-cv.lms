// access: write (ml-classify-cv-model.json and a temporary ml-classify-cv.dslb, both removed)
// What it does: the _dsl_ version of ../ml-classify-cv.lms. Generates 40 labelled points (x = (i - 20)/5, y = x > 0), runs a
//   stratified, shuffled 4-fold cross-validation of a standardised logistic classifier (accuracy and log loss), fits the same
//   model on all rows, saves it, reloads it and reports the class probabilities at x = -2, 0, 2.
// Known answers (scikit-learn 1.7.2: StratifiedKFold(4, shuffle=True, random_state=42), StandardScaler + LogisticRegression(tol=1e-8)):
//   fold accuracies 1, 1, 1, 0.9 (mean 0.975); mean log loss 0.20075185634341353; P(y=1 | x = -2, 0, 2) = 0.08541919955327777,
//   0.4706034083858738, 0.8943013481682253. lmnum reproduces sklearn's fold assignment exactly (numpy RandomState stream).
// Tolerance: fold accuracies exact; mean accuracy >= 0.8 (the original's check); log loss and probabilities 1e-6 (lbfgs stops at
//   tol 1e-8, lmnum's Newton solve goes further: same optimum, T3); reloaded model: bit-identical probabilities.
// How to run: lmscript examples/dsl/ml-classify-cv.lms
import "lmnum.lms";

prog = _dsl_ schema="../../native/schema/lmnum.dsl.json";
let x = arange(40).sub(20.0).div(5.0);
let y = x.gt(0.0);
let cv = ml_cv("logistic", cols(x), y, 4, opts().set("cv", "stratified").set("shuffle", true).set("seed", 42).set("scale", true).set("metrics", strs("accuracy, log_loss")));
out.check("cv status OK", cv.status() == "OK");
out.check("4 folds completed", cv.int("completed_folds") == 4);
out.close("fold accuracies (sklearn)", cv.res("metric_scores").vec("accuracy"), vec(1.0, 1.0, 1.0, 0.9), 0.0);
out.check("mean accuracy >= 0.8", cv.res("metric_mean").num("accuracy") >= 0.8);
out.close("mean log loss (sklearn)", cv.res("metric_mean").num("log_loss"), 0.20075185634341353, 0.000001);
out.put("mean_accuracy", cv.res("metric_mean").num("accuracy"));
out.put("mean_log_loss", cv.res("metric_mean").num("log_loss"));
let m = ml_fit("logistic", cols(x), y, opts().set("scale", true));
out.check("fit status OK", m.ok());
m.save("ml-classify-cv-model.json");
let back = load_model("ml-classify-cv-model.json");
let q = cols(vec(-2.0, 0.0, 2.0));
let p = back.predict_proba(q);
out.check("reloaded model gives identical probabilities", p.max_abs_diff(m.predict_proba(q)) == 0.0);
out.close("P(y=1) at -2, 0, 2 (sklearn)", p.col(1), vec(0.08541919955327777, 0.4706034083858738, 0.8943013481682253), 0.000001);
out.check("predicted classes 0, 0, 1", back.predict(q).sub(vec(0.0, 0.0, 1.0)).abs().max() == 0.0);
out.put("probabilities", p);
out.put("classes", back.classes());
end _dsl_

v = lmnum.run(prog, "ml-classify-cv");
remove_file("ml-classify-cv-model.json");
println("4-fold mean scores:", json_stringify({accuracy: v.mean_accuracy, log_loss: v.mean_log_loss}));
println("Reloaded probabilities (rows x = -2, 0, 2; columns classes", json_stringify(v.classes), "):", json_stringify(v.probabilities));
println("Model: ml-classify-cv-model.json (lmnum JSON model, removed)");
println("Classification CV passed.");
