// access: write (a temporary oracle-kmeans.dslb, removed)
// What it does: the _lmcode_ version of ../oracle-kmeans.lms. Clusters two separated blobs of three points (x = -11..-9 and
//   9..11) with ml_fit("kmeans", ...), seed 42, and proves the partition equals the truth despite label permutation: the
//   pairwise co-membership of every pair of rows must agree (ARI = 1). The original's rcli leg (R kmeans, Lloyd, nstart 10,
//   seed 42) gave the partition 1 1 1 2 2 2 with tot.withinss 16/3; both are pinned here.
// Known answers: partition {0,1,2} {3,4,5}; inertia 16/3 = 2 * (1 + 1 + 2/3) (hand; R 4.x kmeans Lloyd agrees);
//   centres (-10, 1/3) and (10, 1/3).
// Tolerance: co-membership exact; inertia and centres 1e-12.
// How to run: lmscript examples/dsl/oracle-kmeans.lms
import "lmpy.lms";

prog = _lmcode_ schema="../../native/schema/lmpy.dsl.json";
let x = vec("-11 -10 -9 9 10 11");
let z = vec("0 1 0 0 1 0");
let truth = vec("0 0 0 1 1 1");
let r_cluster = vec("1 1 1 2 2 2");
let m = ml_fit("kmeans", cols(x, z), opts().set("n_clusters", 2).set("seed", 42));
let a = m.labels();
let mismatches = 0;
for (i in range(0, 6)) {
  for (j in range(0, 6)) {
    if ((a.at(i) == a.at(j)) != (truth.at(i) == truth.at(j))) { mismatches = mismatches + 1; }
  }
}
out.put("labels", a);
out.put("inertia", m.inertia());
out.check("co-membership equals the hand blobs", mismatches == 0);
out.close("ARI vs hand blobs", adjusted_rand_score(a, truth), 1.0, 0.0);
out.close("ARI vs R kmeans (Lloyd, seed 42)", adjusted_rand_score(a, r_cluster), 1.0, 0.0);
out.close("inertia (hand, R tot.withinss)", m.inertia(), 16.0 / 3.0, 0.000000000001);
let c = m.centers();
let lo = 0;
if (c.at(1, 0) < c.at(0, 0)) { lo = 1; }
out.close("left centre x", c.at(lo, 0), -10.0, 0.000000000001);
out.close("right centre x", c.at(1 - lo, 0), 10.0, 0.000000000001);
out.close("centre z", c.at(lo, 1), 1.0 / 3.0, 0.000000000001);
out.check("predict reproduces the training labels", m.predict(cols(x, z)).sub(a).abs().max() == 0.0);
out.check("status OK", m.ok());
end _lmcode_

v = lmpy.run(prog, "oracle-kmeans");
println("lmpy vs hand blobs: ARI=1, labels", json_stringify(v.labels), sprintf("inertia %.12f", v.inertia));
println("lmpy vs R kmeans Lloyd (pinned partition 1 1 1 2 2 2): ARI=1");
println("kmeans oracle passed.");
