// access: write (a temporary solve.dslb, removed)
// What it does: the _dsl_ version of ../solve.lms: a dense 3x3 solve with a known answer and the normal 97.5% quantile.
// How to run: lmscript examples/dsl/solve.lms   (lmnum on PATH, or LMNUM=/path/to/lmnum)
import "lmnum.lms";

prog = _dsl_ schema="../../native/schema/lmnum.dsl.json";
let a = mat("1 2 3; 0 1 4; 5 6 0");
let x = a.solve(vec(14.0, 14.0, 17.0));
out.put("x", x);
out.close("solution", x, vec(1.0, 2.0, 3.0), 0.000000000001);
out.close("normal quantile", dist("norm").ppf(0.975), 1.959963984540054, 0.00000000000001);
end _dsl_

v = lmnum.run(prog, "solve");
println(f"x = {v.x}");
println("S0 solve and normal quantile passed.");
