// access: write (a temporary oracle-ml-linear.dslb, removed)
// What it does: the _lmcode_ version of ../oracle-ml-linear.lms. Fits ordinary least squares y = 1 + 2 x to seven exact points with
//   ml_fit("linear", ...) and checks the hand optimum. The original's rcli (R lm) and lmstats legs established the same answer
//   (intercept 1, slope 2, exact data), which is asserted here as a pinned known answer. Also checks the fit is exact (R^2 = 1,
//   zero residuals), the rank, and that ridge with a tiny penalty and lasso with a tiny alpha land on the same line.
// Known answers: intercept 1, slope 2 (hand; R 4.x lm and statsmodels OLS agree to 1e-15).
// Tolerance: 1e-9 absolute, as the original.
// How to run: lmscript examples/dsl/oracle-ml-linear.lms   (lmpy on PATH, or LMPY=/path/to/lmpy)
import "lmpy.lms";

prog = _lmcode_ schema="../../native/schema/lmpy.dsl.json";
let x = vec("-3 -2 -1 0 1 2 3");
let y = vec("-5 -3 -1 1 3 5 7");
let m = ml_fit("linear", cols(x), y);
let slope = m.coef().at(0, 0);
let icpt = m.intercept().at(0);
out.put("intercept", icpt);
out.put("slope", slope);
out.put("status", m.status());
out.close("intercept (hand optimum, R lm, statsmodels OLS)", icpt, 1.0, 0.000000001);
out.close("slope (hand optimum, R lm, statsmodels OLS)", slope, 2.0, 0.000000001);
out.check("status OK", m.ok());
out.check("full rank", m.params().int("rank") == 1);
out.close("R^2 of an exact fit", m.score(cols(x), y), 1.0, 0.000000000001);
out.close("residuals vanish", m.predict(cols(x)).sub(y).abs().max(), 0.0, 0.000000001);
let r = ml_fit("ridge", cols(x), y, opts().set("alpha", 0.000000000001));
out.close("ridge(alpha 1e-12) slope", r.coef().at(0, 0), 2.0, 0.000000001);
let l = ml_fit("lasso", cols(x), y, opts().set("alpha", 0.000000000001));
out.close("lasso(alpha 1e-12) slope", l.coef().at(0, 0), 2.0, 0.000000001);
out.check("lasso converged", l.ok());
end _lmcode_

v = lmpy.run(prog, "oracle-ml-linear");
println("lmpy OLS intercept=", v.intercept, "slope=", v.slope, "status=", v.status);
println("hand / R lm / statsmodels: intercept=1 slope=2 (pinned)");
println("ML linear oracle passed.");
