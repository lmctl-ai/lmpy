// access: write (a temporary oracle-dist.dslb, removed)
// What it does: the _lmcode_ version of ../oracle-dist.lms. Evaluates pdf/pmf, log pdf, cdf, survival function and quantiles of the seven families that
//   pycli stats_dist and R both implement (norm, t, chi2/chisq, gamma, beta, binom, poisson/pois) and compares every value with R's, relative error
//   <= 1e-12 (absolute when R's value is exactly 0). The original asked R through rcli at run time; here R's values are pinned known answers,
//   computed once with R 4.3.3 (dnorm/pnorm/qnorm, dt/pt/qt, dchisq/..., dgamma/... with rate = 1/scale, dbeta/..., dbinom/..., dpois/...,
//   printed with %.17g). scipy and R parameterise the same laws differently: scipy scale vs R rate for gamma (scale = 1 / rate), loc/scale vs R
//   mean/sd for norm; the mapping is written in each case's label (the pycli names gamma shape and poisson lam are used, as in the original).
// Tolerance: relative 1e-12 for pdf, log pdf, cdf and sf. Continuous quantiles are root-finders in both libraries and are compared at 1e-10; discrete
//   quantiles are integers and use the 1e-12 bound, i.e. they must match.
// How to run: lmscript examples/dsl/oracle-dist.lms   (lmpy on PATH, or LMPY=/path/to/lmpy)
import "lmpy.lms";

prog = _lmcode_ schema="../../native/schema/lmpy.dsl.json";
fn worst_rel(got: Vec, want: Vec) -> float {
  let w = 0.0;
  for (i in range(0, want.len())) {
    let d = abs(got.at(i) - want.at(i));
    let m = abs(want.at(i));
    let e = d;
    if (m > 0.0) { e = d / m; }
    w = max(w, e);
  }
  return w;
}
fn leg(label: string, name: string, got: Vec, want: Vec, limit: float) -> void {
  let w = worst_rel(got, want);
  out.put(label + " " + name, w);
  out.check(label + " " + name + " agrees with R", w <= limit);
}
fn check_family(label: string, d: Dist, x: Vec, pdf: Vec, logpdf: Vec, cdf: Vec, sf: Vec, ppf: Vec, discrete: bool) -> void {
  let p = vec("0.001 0.05 0.25 0.5 0.75 0.95 0.999");
  leg(label, "pdf", d.pdf(x), pdf, 0.000000000001);
  leg(label, "logpdf", d.logpdf(x), logpdf, 0.000000000001);
  leg(label, "cdf", d.cdf(x), cdf, 0.000000000001);
  leg(label, "sf", d.sf(x), sf, 0.000000000001);
  let qlimit = 0.0000000001;
  if (discrete) { qlimit = 0.000000000001; }
  leg(label, "ppf", d.ppf(p), ppf, qlimit);
}
check_family("norm(1.5, 2)", dist("norm", opts().set("loc", 1.5).set("scale", 2.0)), vec("-4.0 -1.0 0.5 1.5 3.0 6.0"), vec("0.0045467812507955264 0.091324542694510957 0.17603266338214976 0.19947114020071635 0.15056871607740221 0.015869825917833709"), vec("-5.3933357137646185 -2.3933357137646181 -1.7370857137646181 -1.6120857137646181 -1.8933357137646181 -4.1433357137646176"), vec("0.0029797632350545564 0.10564977366685524 0.30853753872598694 0.5 0.77337264762313174 0.98777552734495533"), vec("0.99702023676494544 0.89435022633314476 0.69146246127401301 0.5 0.22662735237686824 0.012224472655044706"), vec("-4.6804646123356264 -1.7897072539029444 0.15102049960783659 1.5 2.8489795003921632 4.7897072539029431 7.6804646123356264"), false);
check_family("t(5)", dist("t", opts().set("df", 5.0)), vec("-6.0 -2.0 -0.3 0.0 1.1 4.0"), vec("0.0006884815401374298 0.065090310326216469 0.35982432834900979 0.37960668982249446 0.19813859080334625 0.0051237270519179125"), vec("-7.2810220518653459 -2.7319795837610812 -1.0221393434397172 -0.96861958905472412 -1.6187885395885853 -5.2738731649226924"), vec("0.00092306914479700695 0.05096973941492916 0.38812452113163726 0.5 0.83927458950368328 0.9948382922595842"), vec("0.99907693085520299 0.9490302605850709 0.61187547886836269 0.5 0.16072541049631678 0.0051617077404157259"), vec("-5.893429531356011 -2.0150483733330233 -0.72668684380042292 0 0.72668684380042292 2.0150483733330224 5.8934295313560092"), false);
check_family("chi2(4) = chisq(4)", dist("chi2", opts().set("df", 4.0)), vec("0.1 1.0 3.0 4.0 9.0 20.0"), vec("0.023780735612517853 0.15163266492815838 0.1673476201113224 0.1353352832366127 0.024995242211045196 0.0002269996488124243"), vec("-3.7388794541139361 -1.8862943611198904 -1.7876820724517808 -2 -3.6890697837836712 -8.3905620875658986"), vec("0.0012091042742502906 0.090204010431049877 0.44217459962892536 0.59399415029016189 0.93890051903966731 0.99950060077261271"), vec("0.99879089572574964 0.90979598956895014 0.55782540037107464 0.40600584970983811 0.061099480960332707 0.00049939922738733355"), vec("0.090804035538979117 0.71072302139732402 1.9225575262295544 3.356693980033322 5.3852690577793911 9.487729036781154 18.466826952903169"), false);
check_family("gamma(shape 3, scale 2) = gamma(shape 3, rate 0.5)", dist("gamma", opts().set("shape", 3.0).set("scale", 2.0)), vec("0.2 1.0 4.0 6.0 12.0 30.0"), vec("0.0022620935450898992 0.037908166232039596 0.1353352832366127 0.11202090382769386 0.022308769589997227 1.7207005528227703e-05"), vec("-6.0914645471079822 -3.2725887222397811 -2 -2.1890697837836712 -3.8027754226637809 -10.970193958915472"), vec("0.0001546530702646717 0.014387677966970687 0.3233235838169366 0.57680991887315658 0.93803119558334103 0.99996069155181555"), vec("0.99984534692973537 0.98561232203302929 0.6766764161830634 0.42319008112684348 0.06196880441665896 3.9308448184484619e-05"), vec("0.38106675513680638 1.6353828943279067 3.4545988357210393 5.3481206274471216 7.8408041205851209 12.591587243743978 22.457744484825323"), false);
check_family("beta(2, 5)", dist("beta", opts().set("a", 2.0).set("b", 5.0)), vec("0.02 0.1 0.3 0.5 0.8 0.95"), vec("0.553420896 1.9683000000000004 2.1608999999999998 0.93750000000000011 0.038399999999999983 0.0001781250000000009"), vec("-0.59163645303606849 0.67717022603680466 0.77052480158128978 -0.064538521137571081 -3.2596978193884563 -8.6330250069413541"), vec("0.0056871235199999993 0.11426500000000002 0.57982500000000015 0.890625 0.99839999999999995 0.99999820312499998"), vec("0.99431287648 0.88573499999999994 0.42017499999999985 0.10937500000000006 0.0015999999999999986 1.7968750000000089e-06"), vec("0.0082554927877466801 0.062849891708354394 0.16116291679032652 0.26444998329565994 0.38947948520072451 0.58180340925202589 0.81861386691913385"), false);
check_family("binom(20, 0.3)", dist("binom", opts().set("n", 20.0).set("p", 0.3)), vec("0.0 1.0 3.0 6.0 10.0 20.0"), vec("0.00079792266297611894 0.00683933711122388 0.071603672205262314 0.19163898275344257 0.030817080900085041 3.4867844009999942e-11"), vec("-7.1334988787746489 -4.9850644656078611 -2.6366089185477173 -1.6521419750931667 -3.4796861680442293 -24.079456086518721"), vec("0.00079792266297611851 0.0076372597742000005 0.10708680450373097 0.60800981220092409 0.98285518356874157 1"), vec("0.99920207733702382 0.99236274022579996 0.89291319549626902 0.39199018779907585 0.017144816431258422 0"), vec("1 3 5 6 7 9 13"), true);
check_family("poisson(4.5) = pois(4.5)", dist("poisson", opts().set("lam", 4.5)), vec("0.0 1.0 4.0 7.0 12.0 25.0"), vec("0.011108996538242306 0.049990484422090392 0.18980762054012446 0.082362949627232576 0.0015991456927801633 1.5322936329372001e-11"), vec("-4.5 -2.9959226032237258 -1.6617442432428493 -2.4966195836314959 -6.4382857343465973 -24.90167030357367"), vec("0.011108996538242306 0.061099480960332707 0.53210357637471561 0.91341352835264389 0.99919486211967867 0.99999999999682199"), vec("0.98889100346175773 0.93890051903966731 0.46789642362528439 0.086586471647356056 0.00080513788032133421 3.178046909356229e-12"), vec("0 1 3 4 6 8 12"), true);
end _lmcode_

v = lmpy.run(prog, "oracle-dist");
worst = 0;
for (k in keys(v)) { if (v[k] > worst) { worst = v[k]; } }
labels = ["norm(1.5, 2)", "t(5)", "chi2(4) = chisq(4)", "gamma(shape 3, scale 2) = gamma(shape 3, rate 0.5)", "beta(2, 5)", "binom(20, 0.3)", "poisson(4.5) = pois(4.5)"];
for (c in labels) {
  line = c + ":";
  for (leg in ["pdf", "logpdf", "cdf", "sf", "ppf"]) { line = line + sprintf(" %s %.3f", leg, v[c + " " + leg] * 1000000000000); }
  println(line + " (relative differences in units of 1e-12)");
}
println(sprintf("217 values over 7 families, 5 functions agree with R's pinned values; worst relative difference %.3f x 1e-12 (bounds: 1e-12, continuous ppf 1e-10)", worst * 1000000000000));
println("Distribution functions agree with R.");
