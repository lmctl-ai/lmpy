// access: write (a temporary tut-kmeans-cv.dslb, removed)
// Topic: clustering and classification with cross-validation on an iris-style table (after: the scikit-learn user guide's
//   k-means and cross-validation sections and the classic iris tutorial)
// What it does: the _dsl_ version of ../tut-kmeans-cv.lms, in one native program: clusters the petal measurements with k-means
//   (fixed seed), measures cluster purity against the species, runs a stratified, shuffled 5-fold cross-validation of a
//   standardised 5-nearest-neighbours classifier on all four measurements, fits a standardised logistic classifier and scores
//   its training predictions with ml_metrics (confusion matrix, accuracy, macro F1).
// Checks (the original's): purity >= 0.9 with one cluster per species, CV accuracy >= 0.9, training accuracy >= 0.95, and the
//   confusion-matrix diagonal reproduces the accuracy. Pinned known answers (scikit-learn 1.7.2 with the same seeds; lmpy
//   reproduces its fold assignment and k-means stream): k-means inertia 16.564069607631957 with cluster sizes 49 50 51, kNN fold
//   accuracies 1, 0.9667, 1, 1, 1 (mean 0.9933333333333334, sd 0.01333333333333333), macro F1 0.9933166248955722, logistic
//   training accuracy 1.
// Tolerance: fold scores 1e-12; inertia 1e-9 relative.
// Data: examples/data/tut-flowers.csv, 150 rows: three species, 50 each, four normal measurements around species means (seed 113).
// How to run: lmscript examples/dsl/tut-kmeans-cv.lms
import "lmpy.lms";

prog = _dsl_ schema="../../native/schema/lmpy.dsl.json";
let f = read_csv("../data/tut-flowers.csv");
let enc = label_encode(f.text("species"));
let species = enc.strs("classes");
let truth = enc.vec("codes");
let n = f.nrows();

# 1. k-means on the two petal measurements; species x cluster table and purity
let km = ml_fit("kmeans", f.to_mat(strs("petal_length, petal_width")), opts().set("n_clusters", 3).set("seed", 7));
let clusters = km.predict(f.to_mat(strs("petal_length, petal_width")));
let table = ml_metrics(truth, clusters, opts().set("metrics", strs("confusion_matrix"))).mat("confusion_matrix");
let agree = 0.0;
let used = zeros(3);
for (s in range(0, 3)) {
  let best = 0;
  for (c in range(1, 3)) { if (table.at(s, c) > table.at(s, best)) { best = c; } }
  agree = agree + table.at(s, best);
  used.set(s, float(best));
}
let purity = agree / float(n);
out.put("centers", km.centers());
out.put("table", table);
out.put("purity", purity);
out.put("used", used);
out.check("k-means purity >= 0.9", purity >= 0.9);
out.check("one majority cluster per species", used.at(0) != used.at(1) && used.at(0) != used.at(2) && used.at(1) != used.at(2));
out.close_rel("k-means inertia (sklearn)", km.inertia(), 16.564069607631957, 0.000000001);

# 2. stratified 5-fold CV of a 5-nearest-neighbours classifier on all four measurements (scaled per fold)
let all = f.to_mat(strs("sepal_length, sepal_width, petal_length, petal_width"));
let cv = ml_cv("knn_classifier", all, truth, 5, opts().set("n_neighbors", 5).set("scale", true).set("cv", "stratified").set("shuffle", true).set("seed", 11).set("metrics", strs("accuracy, f1_macro")));
let acc = cv.res("metric_mean").num("accuracy");
out.put("cv_accuracy", acc);
out.put("cv_sd", cv.res("metric_std").num("accuracy"));
out.put("cv_f1", cv.res("metric_mean").num("f1_macro"));
out.put("fold_accuracy", cv.res("metric_scores").vec("accuracy"));
out.put("fold_test_rows", cv.vec("test_rows"));
out.put("fold_train_rows", cv.vec("train_rows"));
out.check("5 folds completed", cv.int("completed_folds") == 5);
out.check("cross-validated accuracy >= 0.9", acc >= 0.9);
out.close("fold accuracies (sklearn)", cv.res("metric_scores").vec("accuracy"), vec("1 0.9666666666666667 1 1 1"), 0.000000000001);
out.close("CV sd (sklearn, ddof 0)", cv.res("metric_std").num("accuracy"), 0.01333333333333333, 0.000000000001);
out.close("CV macro F1 (sklearn)", cv.res("metric_mean").num("f1_macro"), 0.9933166248955722, 0.000000000001);

# 3. logistic classifier, its training predictions and their metrics
let lg = ml_fit("logistic", all, truth, opts().set("scale", true));
let mt = ml_metrics(truth, lg.predict(all), opts().set("metrics", strs("confusion_matrix, accuracy, f1")).set("average", "macro"));
let conf = mt.mat("confusion_matrix");
let dsum = conf.at(0, 0) + conf.at(1, 1) + conf.at(2, 2);
out.put("train_accuracy", mt.num("accuracy"));
out.put("train_f1", mt.num("f1"));
out.put("confusion", conf);
out.check("training accuracy >= 0.95", mt.num("accuracy") >= 0.95 && mt.int("n") == n);
out.close("confusion diagonal reproduces the accuracy", dsum / float(n), mt.num("accuracy"), 0.000000001);
out.close("training accuracy (sklearn)", mt.num("accuracy"), 1.0, 0.0);
out.put("species", species);
end _dsl_

v = lmpy.run(prog, "tut-kmeans-cv");
println("k-means centres (petal_length, petal_width):", json_stringify(v.centers));
println("species x cluster:", json_stringify(v.table));
println(sprintf("cluster purity (majority cluster per species): %.3f; species -> cluster %s", v.purity, json_stringify(v.used)));
println(sprintf("5-fold kNN: accuracy %.3f (sd %.3f), macro F1 %.3f", v.cv_accuracy, v.cv_sd, v.cv_f1));
for (i = 0; i < 5; i = i + 1) { println(sprintf("  fold %d: train %d test %d accuracy %.3f", i, v.fold_train_rows[i], v.fold_test_rows[i], v.fold_accuracy[i])); }
println(sprintf("logistic training accuracy %.3f, macro F1 %.3f; confusion matrix %s (rows true, columns predicted, %s)", v.train_accuracy, v.train_f1, json_stringify(v.confusion), json_stringify(v.species)));
println(sprintf("Checks passed: purity %.3f, CV accuracy %.3f, training accuracy %.3f.", v.purity, v.cv_accuracy, v.train_accuracy));
