// access: write (a temporary oracle-sm-arima.dslb, removed)
// What it does: the _dsl_ version of ../oracle-sm-arima.lms. Fits ARMA(1,1) without a mean to a 120-point series with `arima`
//   (statsmodels SARIMAX exact Gaussian likelihood) and checks the AR/MA parameters, the innovation variance, the log-likelihood and a
//   5-step forecast against R 4.3.3 arima(method = "ML") (the golden constants of the original; its rcli and statsrust legs fitted the
//   same model). It also checks that the forecast interval is mean +- z(0.975) * se and that the residual Ljung-Box test (model_df 2)
//   finds no autocorrelation left.
// Tolerance: 1e-3 absolute for parameters, variance, forecasts and log-likelihood: iterative maximum likelihood, the optimizers stop at
//   slightly different points of a flat likelihood (lmpy lands within 1e-6 of statsmodels' own optimum).
// How to run: lmscript examples/dsl/oracle-sm-arima.lms   (lmpy on PATH, or LMPY=/path/to/lmpy)
import "lmpy.lms";

prog = _dsl_ schema="../../native/schema/lmpy.dsl.json";
let s = vec("1.711067, 1.950077, 0.993479, 2.023794, 3.453829, 0.578432, -0.44952, -0.767853, -0.476348, 1.309661, -0.453622, 0.757637, 0.819034, -0.365827, 1.445735, 0.028669, 1.022639, 0.035805, 1.370305, 2.140949, 1.458921, 0.205727, 1.969063, 0.182424, -0.018104, 0.701203, 0.629847, -0.61745, -1.785113, -2.585672, -1.174721, -0.756786, -1.076715, 0.420553, 1.381112, -1.444828, -1.799813, -1.904894, -1.123578, -1.70666, -1.12284, -0.703516, -2.311815, -0.948614, 0.125585, -1.485551, 0.473432, 0.653838, 0.497185, 0.571642, -0.694302, -1.243102, -2.173681, -0.539678, -1.074198, 0.351298, -0.729166, -0.67223, -1.932696, -0.686771, 0.793329, 1.816287, 1.86441, 1.236054, 0.710433, -0.304354, -1.699413, -0.298616, 1.349212, 1.789738, 2.508197, 0.605009, 0.285838, -0.402331, -0.606723, -2.069574, -1.129054, -0.730502, -0.277475, -0.446977, -2.463374, -1.570972, -0.4483, -0.45778, -0.244125, 0.541801, -0.320608, -0.618947, 0.541034, 2.624481, 0.915248, 1.585814, 1.641114, 0.309236, 0.511232, 1.739555, 2.492113, 1.414169, -1.045194, 0.244345, 1.023871, -1.354144, -2.228578, -1.980628, -0.976562, 0.317488, 0.24733, -1.237032, -1.720789, -0.687724, -2.057374, -2.01787, -0.713297, -0.644801, -1.852762, -0.635152, -2.146743, -1.612279, -0.209231, -0.150042");
let fit = arima(s, 1, 0, 1, opts().set("trend", "n").set("forecast_steps", 5));
let c = fit.res("coefficients");
let est = c.vec("estimate");
let fc = fit.res("forecast");
# R 4.3.3 arima(s, order = c(1, 0, 1), include.mean = FALSE, method = "ML"): ar1, ma1, sigma2, loglik, predict(n.ahead = 5)
out.check("status OK", fit.ok());
out.check("names", c.strs("names").join(",") == "ar.L1,ma.L1,sigma2");
out.close("ar.L1 vs R", est.at(0), 0.5745258882876039, 0.001);
out.close("ma.L1 vs R", est.at(1), 0.05445130866767214, 0.001);
out.close("sigma2 vs R", fit.num("sigma2"), 1.0650504361214743, 0.001);
out.close("llf vs R", fit.num("llf"), -174.28654082259692, 0.001);
out.close("forecast vs R", fc.vec("mean"), vec("-0.08999880500544839, -0.05170664339057809, -0.02970680522434224, -0.017067328659702057, -0.009805622158911804"), 0.001);
# the interval half-width at h = 1 is z(0.975) * sqrt(sigma2) (one-step forecast variance of an ARMA model)
out.close("interval h=1", (fc.vec("upper").at(0) - fc.vec("lower").at(0)) / 2.0, 1.959963984540054 * sqrt(fit.num("sigma2")), 0.000000001);
let lb = ljung_box(fit.vec("residuals"), 10, opts().set("model_df", 2));
out.check("residuals white (Ljung-Box p > 0.05)", lb.vec("p_value").at(-1) > 0.05);
out.put("names", c.strs("names"));
out.put("estimate", est);
out.put("std_err", c.vec("std_err"));
out.put("llf", fit.num("llf"));
out.put("aic", fit.num("aic"));
out.put("forecast", fc.vec("mean"));
out.put("lb_p", lb.vec("p_value").at(-1));
end _dsl_

v = lmpy.run(prog, "oracle-sm-arima");
println("lmpy: " + json_stringify(v.names) + sprintf(" llf=%.8f aic=%.6f", v.llf, v.aic));
for (i = 0; i < len(v.names); i = i + 1) { println(sprintf("  %-7s %.10f (se %.6f)", v.names[i], v.estimate[i], v.std_err[i])); }
println("forecast: " + json_stringify(v.forecast));
println(sprintf("residual Ljung-Box Q(10) p = %.3f", v.lb_p));
println("ARMA(1,1) agrees within 1e-3.");
