// access: write (the measurement and out-of-spec CSVs, removed; a temporary .dslb)
// Task: a production quality review, in one native program.
//   1. simulate 240 shaft diameters (3 lines x 2 shifts x 40 parts) with a seeded generator and write them as CSV;
//   2. read the CSV back and summarise by line and shift (mean, std, count);
//   3. fit diameter ~ C(line) + C(shift) by OLS and test the line effect with an F test of the nested models (F survival function);
//   4. compare the lines pairwise with Welch t tests and a Bonferroni correction;
//   5. process capability per line (Cpk against the specification 10.00 +- 0.06 mm) and the out-of-spec parts, exported as CSV.
// Data: line means 10.000 / 10.020 / 9.990 mm, night shift +0.010 mm, sd 0.020 mm (rng seed 2026, numpy-identical stream).
// Checks: the line effect is significant (p < 1e-6); B differs from A and from C after Bonferroni; the fitted shift effect is within
//   3 SE of 0.010; every coefficient's 95% interval reproduces estimate +- t * SE; Cpk recomputed by hand; spec counts consistent.
// How to run: lmscript examples/dsl/task-quality-control.lms   (lmpy on PATH, or LMPY=/path/to/lmpy)
import "lmpy.lms";

prog = _lmcode_ schema="../../native/schema/lmpy.dsl.json";
# step 1
let gen = rng(2026);
let lines = strs("A, B, C");
let means = vec(10.0, 10.02, 9.99);
let shifts = strs("day, night");
let col_line = strs();
let col_shift = strs();
let diam = vec();
for (l in range(0, 3)) {
  for (s in range(0, 2)) {
    let d = gen.normal(40, means.at(l) + 0.01 * float(s), 0.02);
    diam.extend(d);
    for (k in range(0, 40)) { col_line.push(lines.at(l)); col_shift.push(shifts.at(s)); }
  }
}
frame().with("line", col_line).with("shift", col_shift).with("diameter", diam).write_csv("shafts-dsl.csv");
# step 2
let data = read_csv("shafts-dsl.csv");
let summary = data.groupby(strs("line, shift"), "diameter:mean|std|count");
out.put("summary", summary);
# step 3: full and reduced models
let fullm = ols(data, "diameter", strs("C(line), C(shift)"));
let reduced = ols(data, "diameter", strs("C(shift)"));
let df_num = float(reduced.int("df_resid") - fullm.int("df_resid"));
let df_den = float(fullm.int("df_resid"));
let f = ((reduced.num("ssr") - fullm.num("ssr")) / df_num) / (fullm.num("ssr") / df_den);
let p_line = dist("f", opts().set("dfn", df_num).set("dfd", df_den)).sf(f);
out.put("line_F", f);
out.put("line_p", p_line);
out.check("line effect significant (p < 1e-6)", p_line < 0.000001);
let co = fullm.res("coefficients");
let names = co.strs("names");
let shift_i = names.index("C(shift)[T.night]");
let est = co.vec("estimate");
let se = co.vec("std_err");
out.put("shift_effect", est.at(shift_i));
out.close("night shift effect within 3 SE of 0.010", est.at(shift_i), 0.01, 3.0 * se.at(shift_i));
let tq = dist("t", opts().set("df", df_den)).ppf(0.975);
out.close("CI = estimate - t SE", co.vec("ci_lower").sub(est - se.mul(tq)).abs().max(), 0.0, 0.000000001);
# step 4: pairwise Welch tests, Bonferroni over 3 pairs
let pairs = strs();
let pvals = vec();
for (i in range(0, 3)) {
  for (j in range(i + 1, 3)) {
    let tt = ttest_ind(data.where("line", lines.at(i)).col("diameter"), data.where("line", lines.at(j)).col("diameter"), opts().set("equal_var", false));
    pairs.push(lines.at(i) + "-" + lines.at(j));
    pvals.push(min(1.0, 3.0 * tt.num("pvalue")));
  }
}
out.put("pairs", pairs);
out.put("bonferroni_p", pvals);
out.check("A-B differ after Bonferroni", pvals.at(0) < 0.01);
out.check("B-C differ after Bonferroni", pvals.at(2) < 0.01);
# step 5: capability and out-of-spec parts
let lsl = 9.94;
let usl = 10.06;
let cpk = vec();
for (l in lines) {
  let d = data.where("line", l).col("diameter");
  let m = d.mean();
  let sd = d.std(1);
  cpk.push(min(usl - m, m - lsl) / (3.0 * sd));
}
out.put("cpk", cpk);
out.check("line B is the least capable", cpk.at(1) < cpk.at(0) && cpk.at(1) < cpk.at(2));
let bad = data.filter("diameter < 9.94 | diameter > 10.06");
bad.write_csv("out-of-spec-dsl.csv");
out.put("out_of_spec", bad.nrows());
out.check("spec count consistent", bad.nrows() == diam.lt(lsl).count() + diam.gt(usl).count());
end _lmcode_

v = lmpy.run(prog, "task-quality-control");
s = v.summary.data;
for (i = 0; i < len(s.line); i = i + 1) { println(sprintf("  line %s %-5s mean %.4f sd %.4f n %d", s.line[i], s["shift"][i], s["diameter__mean"][i], s["diameter__std"][i], s["diameter__count"][i])); }
println(sprintf("line effect F = %.1f, p = %s; night shift +%.4f mm", v.line_F, str(v.line_p), v.shift_effect));
for (i = 0; i < 3; i = i + 1) { println(sprintf("  %s Bonferroni p %s", v.pairs[i], str(v.bonferroni_p[i]))); }
println(sprintf("Cpk A %.2f  B %.2f  C %.2f; %d parts out of spec (exported)", v.cpk[0], v.cpk[1], v.cpk[2], v.out_of_spec));
for (path in ["shafts-dsl.csv", "out-of-spec-dsl.csv"]) { delete_file(path); }
println("Quality control task passed.");
