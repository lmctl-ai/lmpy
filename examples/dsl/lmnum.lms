// Shared runner for the _dsl_ examples: save the compiled block as bytecode, run the native host on it, return the
// values the block recorded with out.put(...). The host is `lmnum` (one static executable, no Python/R/Docker):
// $LMNUM when set, else `lmnum` on PATH. Without it the example prints SKIPPED and exits 0.
//   import "lmnum.lms";
//   values = lmnum.run(prog, "my-example");   // prog = _dsl_ schema="../../native/schema/lmnum.dsl.json"; ... end _dsl_
package lmnum;

fn exe() {
  b = env("LMNUM", "");
  if (b != "") { return b; }
  return which("lmnum");
}

// Runs the block; on failure prints the host's one-line JSON error (it names the DSL line) and exits 1.
fn run(prog, name) {
  bin = exe();
  if (bin == null) {
    println(f"SKIPPED: lmnum is not on PATH (build it: cmake -S native -B native/build && cmake --build native/build; then set LMNUM)");
    exit(0);
  }
  file = f"{name}.dslb";
  savedsl(prog, file);
  r = system([bin, "--dsl", file], 300000);
  remove_file(file);
  if (r.code != 0 || r.timed_out) {
    println(f"{name}: lmnum exit {r.code}: {trim(r.stdout)}");
    if (trim(r.stderr) != "") { println(trim(r.stderr)); }
    exit(1);
  }
  return json_parse(r.stdout).result.values;
}
