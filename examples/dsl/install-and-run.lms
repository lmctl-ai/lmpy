// access: write (compiler-managed invocation and any documented example artifacts)
// What it does: the zero-setup way to use lmpy from lmscript. No schema file and no manual install:
//   - cli="lmpy" makes lmscript ask the lmpy binary for its schema (`lmpy --lmcode-schema --json`) and compile against exactly
//     those bytes, so the bytecode is bound to the binary that will run it;
//   - install="github:lmctl-ai/lmpy@latest" says where lmpy comes from when it is not on PATH: lmscript downloads the
//     release asset lmpy-OS-ARCH[.exe] (linux/macos/windows, x64/arm64) once into its tool cache, verified against the
//     SHA-256 digest GitHub reports, and uses it from then on;
//   - run_lmcode(p) runs that exact binary and returns the decoded invocation result.
// The program itself: a normal-distribution quantile, a 3x3 solve and a least-squares line, with known answers.
// How to run: lmscript examples/dsl/install-and-run.lms   (works on a machine with only Node.js and lmscript installed)
p = _lmcode_ cli="lmpy" install="github:lmctl-ai/lmpy@latest";
out.close("normal 97.5% quantile", dist("norm").ppf(0.975), 1.959963984540054, 0.00000000000001);
out.close("3x3 solve", mat("1 2 3; 0 1 4; 5 6 0").solve(vec(14.0, 14.0, 17.0)), vec(1.0, 2.0, 3.0), 0.000000000001);
let x = arange(10);
let fit = cols(ones(10), x).lstsq(x.mul(2.0).add(1.0));
out.close("line y = 1 + 2x", fit.vec("x"), vec(1.0, 2.0), 0.000000000001);
out.put("binary_version_check", "ok");
end _lmcode_

r = run_lmcode(p);
require(r.ok, json_stringify(r));
res = r.result;
println(f"lmpy: {res.checks.passed} checks passed");
println("Install-and-run passed.");
