// access: write (a temporary .dslb, removed)
// Python original: scipy-find-peaks.py, the SciPy reference examples for scipy.signal.peak_prominences and peak_widths
//   (x = sin(t) + 0.6 sin(2.6 t) on 1000 points of [0, 6 pi]; the 9-sample edge case with and without wlen=3.1) and the
//   find_peaks example conditions (height=0, distance=150, prominence=(None, 0.6), prominence=1 with width=20) run on the same
//   signal plus 0.05 x default_rng(7) noise instead of the downloaded electrocardiogram. lmpy calls find_peaks,
//   peak_prominences and peak_widths with the same options; the pinned answers are what the .py prints with scipy 1.16.2.
// Check: examples/python/check-parity.sh scipy-find-peaks (runs both and compares every recorded value).
import "../dsl/lmpy.lms";

prog = _lmcode_ schema="../../native/schema/lmpy.dsl.json";
let t = linspace(0.0, 6.0 * pi(), 1000);
let x = t.sin().add(t.mul(2.6).sin().mul(0.6));
let peaks = find_peaks(x).vec("indices");
let prom = peak_prominences(x, peaks).vec("prominences");
let half = peak_widths(x, peaks, opts().set("rel_height", 0.5));
let whole = peak_widths(x, peaks, opts().set("rel_height", 1.0));
out.put("peaks", peaks);
out.put("prominences", prom);
out.put("contour_heights", x.take(peaks).sub(prom));
out.put("widths_half", half.vec("widths"));
out.put("width_heights_half", half.vec("width_heights"));
out.put("left_ips_half", half.vec("left_ips"));
out.put("right_ips_half", half.vec("right_ips"));
out.put("widths_full", whole.vec("widths"));
out.close("peak indices (scipy docs)", peaks, vec("42 147 299 416 533 685 791 933"), 0.0);
out.close("prominences (scipy docs, 8 digits)", prom, vec("1.24159486 0.47840168 0.28470524 3.10716793 0.284603 0.47822491 2.48340261 0.47822491"), 0.000000005);
out.close("half widths (scipy docs, 8 digits)", half.vec("widths"), vec("64.25172825 41.29465463 35.46943289 104.71586081 35.46729324 41.30429622 181.93835853 45.37078546"), 0.000000005);
out.close("full widths (scipy docs, 8 digits)", whole.vec("widths"), vec("181.9396084 72.99284945 61.28657872 373.84622694 61.78404617 72.48822812 253.09161876 79.36860878"), 0.000000005);

# edge case: one peak at index 5, then a window of wlen = 3.1 (rounded up to 5 samples)
let e = vec("0 1 0 3 1 3 0 4 0");
let edge = peak_prominences(e, vec(5.0));
let edge_w = peak_prominences(e, vec(5.0), opts().set("wlen", 3.1));
out.put("edge_prominence", edge.vec("prominences"));
out.put("edge_left_base", edge.vec("left_bases"));
out.put("edge_right_base", edge.vec("right_bases"));
out.put("edge_wlen_prominence", edge_w.vec("prominences"));
out.put("edge_wlen_left_base", edge_w.vec("left_bases"));
out.put("edge_wlen_right_base", edge_w.vec("right_bases"));
out.close("edge case (3, 2, 6) (scipy docs)", vec(edge.vec("prominences").at(0), edge.vec("left_bases").at(0), edge.vec("right_bases").at(0)), vec(3.0, 2.0, 6.0), 0.0);
out.close("edge case wlen=3.1 (2, 4, 6) (scipy docs)", vec(edge_w.vec("prominences").at(0), edge_w.vec("left_bases").at(0), edge_w.vec("right_bases").at(0)), vec(2.0, 4.0, 6.0), 0.0);

# the find_peaks example conditions on the noisy signal
let noisy = x.add(rng(7).standard_normal(1000).mul(0.05));
let p_height = find_peaks(noisy, opts().set("height", 0.0));
let p_dist = find_peaks(noisy, opts().set("distance", 150.0)).vec("indices");
let p_low = find_peaks(noisy, opts().set("prominence", vec(nan(), 0.6)));
let p_big = find_peaks(noisy, opts().set("prominence", 1.0).set("width", 20.0));
out.put("noisy_height0_count", p_height.int("n_peaks"));
out.put("noisy_distance150", p_dist);
out.put("noisy_distance150_diff", p_dist.diff());
out.put("noisy_low_prominence_count", p_low.int("n_peaks"));
out.put("noisy_low_prominence_max", p_low.vec("prominences").max());
out.put("noisy_big_peaks", p_big.vec("indices"));
out.put("noisy_big_prominences", p_big.vec("prominences"));
out.put("noisy_big_widths", p_big.vec("widths"));
out.check("154 peaks above 0 (scipy 1.16.2)", p_height.int("n_peaks") == 154);
out.close("distance=150 peaks (scipy 1.16.2)", p_dist, vec("44 265 416 641 791 941"), 0.0);
out.check("303 peaks with prominence <= 0.6 (scipy 1.16.2)", p_low.int("n_peaks") == 303);
out.close("largest low prominence (scipy 1.16.2)", p_low.vec("prominences").max(), 0.4363565000315597, 0.000000000001);
out.close("prominence >= 1 and width >= 20 peaks (scipy 1.16.2)", p_big.vec("indices"), vec(44.0, 416.0, 791.0), 0.0);
out.close("their widths (scipy 1.16.2)", p_big.vec("widths"), vec(61.68995178923274, 98.37966495720849, 180.5557775268768), 0.000000001);
end _lmcode_

v = lmpy.run(prog, "scipy-find-peaks");
println(sprintf("two-harmonic signal: peaks %s, largest prominence %.6f", json_stringify(v.peaks), v.prominences[3]));
println(sprintf("noisy signal: %d peaks above 0, distance=150 keeps %s", v.noisy_height0_count, json_stringify(v.noisy_distance150)));
println("scipy find_peaks/peak_prominences/peak_widths answers reproduced.");
