// One concept: compute the 97.5th percentile of a standard normal distribution.
if (!file_exists("build")) { mkdir("build"); }
p = _dsl_ cli="lmpy" install="github:lmctl-ai/lmpy@latest";
let q = dist("norm").ppf(0.975);
out.close("normal 97.5% quantile", q, 1.959963984540054, 0.00000000000001);
out.put("quantile", q);
end _dsl_

file = "build/normal-quantile.dslb";
savedsl(p, file);
r = system ${dsl_cli(p)} --dsl ${file};
delete_file(file);
if (r.code != 0) { println("lmpy failed: " + trim(r.stderr)); exit(r.code); }
result = json_parse(r.stdout).result.values;
println("97.5% standard normal quantile: " + str(result.quantile));
