// One concept: fit y = 3 + 2x by ordinary least squares.
if (!file_exists("build")) { mkdir("build"); }
p = _dsl_ cli="lmpy" install="github:lmctl-ai/lmpy@latest";
let x = arange(5);
let fit = cols(ones(5), x).lstsq(x.mul(2.0).add(3.0));
let coefficients = fit.vec("x");
out.check("fit succeeded", fit.ok());
out.close("intercept and slope", coefficients, vec(3.0, 2.0), 0.000000000001);
out.put("coefficients", coefficients);
end _dsl_

file = "build/least-squares-line.dslb";
savedsl(p, file);
r = system ${dsl_cli(p)} --dsl ${file};
delete_file(file);
if (r.code != 0) { println("lmpy failed: " + trim(r.stderr)); exit(r.code); }
result = json_parse(r.stdout).result.values;
println("Fitted coefficients [intercept, slope]: " + str(result.coefficients));
