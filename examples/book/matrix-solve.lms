// One concept: solve a 3 by 3 linear system with a known solution.
if (!file_exists("build")) { mkdir("build"); }
p = _lmcode_ cli="lmpy" install="github:lmctl-ai/lmpy@latest";
let solution = mat("1 2 3; 0 1 4; 5 6 0").solve(vec(14.0, 14.0, 17.0));
out.close("known linear-system solution", solution, vec(1.0, 2.0, 3.0), 0.000000000001);
out.put("solution", solution);
end _lmcode_

r = run_lmcode(p);
assert(r.ok, "lmpy invocation failed: " + json_stringify(r));
result = r.result.values;
println("Solution: " + str(result.solution));
