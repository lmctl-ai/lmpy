// access: write
import "../cli.schema.dev.json" as pycli;
write_file("demand-s4.csv","total_units,quality_min,regular_capacity,premium_capacity,regular_cost,premium_cost\n3,5,4,3,1,2\n");
loaded=pycli.frame_import({csv:"demand-s4.csv",out:"demand-s4.npz"});
if (loaded.status=="simulated") { println("Production plan simulated."); exit(0); }
if (loaded.status!="ok") { println(json_stringify(loaded)); exit(1); }
inspected=pycli.frame_inspect({frame:"demand-s4.npz",head:1});
if (inspected.status!="ok") { println(json_stringify(inspected)); exit(1); }
d=inspected.result.head.data;
plan=pycli.opt_linprog({c:[d.regular_cost[0],d.premium_cost[0]],a_ub:[[-1,-1],[-1,-3]],b_ub:[-d.total_units[0],-d.quality_min[0]],bounds:[[0,d.regular_capacity[0]],[0,d.premium_capacity[0]]]});
if (plan.status!="ok" || plan.result.status!="OK") { println(json_stringify(plan)); exit(1); }
x=plan.result.x;
// Hand optimum: x+y=3 and x+3y=5 -> regular=2, premium=1, total cost=4.
if (abs(x[0]-2)>0.00000001 || abs(x[1]-1)>0.00000001 || abs(plan.result.objective-4)>0.00000001) { println("Plan differs from hand optimum"); exit(1); }
println(sprintf("regular=%.6f premium=%.6f total_cost=%.6f",x[0],x[1],plan.result.objective));
delete_file("demand-s4.csv"); delete_file("demand-s4.npz");
