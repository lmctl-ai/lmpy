// access: read
// Cross-language agreement: ordinary least squares in Python (pycli sm_ols, statsmodels) and R (rcli fit_lm, lm).
// What it does: reads examples/data/tut-ols.csv, fits y ~ x1 + x2 with both tools from the same inline columns and compares the
//   three coefficients, their standard errors, R^2 and sigma side by side. Both are closed-form least squares (statsmodels: pseudo-
//   inverse; R: Householder QR), so the only legitimate difference is rounding: the coefficient tolerance is 64 eps cond(X) max(1, |b|)
//   and the standard-error tolerance 64 eps cond(X)^2 max(1, se) (the inverse crossproduct amplifies rounding by cond^2), with the
//   condition number taken from sm_ols; R^2 and sigma are compared at 1e-12.
// Data: examples/data/tut-ols.csv (seed 101, scripts/generate-tutorial-data.py).
// Usage: export PATH=$PWD/bin:$HOME/repos/lmctlhq/rcli/bin:$PATH; lmscript examples/cross-ols.lms   (rcli absent: the R leg is skipped with a hint, exit 0)
import "../cli.schema.dev.json" as pycli;
import "schemas/rcli.cli.schema.v1.json" as rcli;

EPS = 0.0000000000000002220446049250313;
function check(label, a, b, tol) {
  d = abs(a - b); ok = d <= tol;
  println(sprintf("%-28s %20.14f %20.14f  %-24s %-12s %s", label, a, b, str(d), str(tol), ok ? "ok" : "FAIL"));
  return ok ? 0 : 1;
}
rows = read_csv("examples/data/tut-ols.csv"); x1 = pluck(rows, "x1"); x2 = pluck(rows, "x2"); y = pluck(rows, "y");
py = pycli.sm_ols({columns: {y: y, x1: x1, x2: x2}, y: "y", terms: [{var: "x1"}, {var: "x2"}]});
if (py.status == "simulated") { println("OLS agreement simulated."); exit(0); }
if (py.status != "ok" || py.result.status != "OK") { println("pycli sm_ols failed:", json_stringify(py)); exit(1); }
if (which("rcli") == null) { println("rcli is not on PATH: R leg skipped (export PATH=$HOME/repos/lmctlhq/rcli/bin:$PATH)"); exit(0); }
r = rcli.fit_lm({formula: "y ~ x1 + x2", data: {y: y, x1: x1, x2: x2}});
if (r.status != "ok") { println("rcli fit_lm failed:", json_stringify(r)); exit(1); }
p = py.result; q = r.result; c = p.coefficients;
cond = p.condition_number;
println(sprintf("n = %d, cond(X) = %.3f (statsmodels), R rank %d", p.n_obs, cond, q.rank));
println(sprintf("%-28s %20s %20s  %-24s %-12s %s", "quantity", "python", "r", "abs diff", "tolerance", "verdict"));
bad = 0;
for (i = 0; i < 3; i = i + 1) {
  bad = bad + check("coef " + c.names[i], c.estimate[i], q.estimate[i], 64 * EPS * cond * max(1, abs(c.estimate[i])));
  bad = bad + check("se " + c.names[i], c.std_err[i], q.std_error[i], 64 * EPS * cond * cond * max(1, c.std_err[i]));
}
bad = bad + check("r2", p.r2, q.r_squared, 0.000000000001);
bad = bad + check("sigma", p.sigma, q.sigma, 0.000000000001);
if (bad > 0) { println(bad, "quantities disagree beyond tolerance"); exit(1); }
println("Agreement: Python and R OLS coefficients, standard errors, R^2 and sigma agree within rounding (cond-derived tolerances).");
