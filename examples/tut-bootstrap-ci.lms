// access: write
// Topic: a seeded bootstrap confidence interval for the mean of a skewed sample (after: the scipy-lectures statistics chapter and
//   the classic "bootstrap the mean" exercise)
// What it does: loads the sample, draws 1000 bootstrap resamples with explicit PCG64 seeds (stats_dist rvs uniform; each uniform
//   supplies two indices, floor(n u) and floor(n frac(n u)), so 20 calls of 1000 draws cover the 40000 indices), reports the
//   percentile interval and the bootstrap standard error, and compares them with the normal-theory t interval (stats_dist t ppf)
//   and with the generating distribution's moments (stats_dist moments). The checks fail when resampling is broken: every row
//   must be drawn, the bootstrap mean must sit within 0.25 SE of the sample mean and the bootstrap SE within 15% of s / sqrt(n).
// Data: examples/data/tut-bootstrap.csv, 40 draws from gamma(shape 2, scale 5): mean 10, variance 50 (seed 105).
// Usage: export PATH=/path/to/pycli/bin:$PATH; lmscript examples/tut-bootstrap-ci.lms   (writes and removes tut-bootstrap.npz in cwd)
import "../cli.schema.dev.json" as pycli;

B = 1000;
if (file_exists("tut-bootstrap.npz")) { delete_file("tut-bootstrap.npz"); }   // a stale file from an interrupted run would be a CONFLICT
loaded = pycli.frame_import({csv: "examples/data/tut-bootstrap.csv", out: "tut-bootstrap.npz"});
if (loaded.status == "simulated") { println("Bootstrap simulated."); exit(0); }
if (loaded.status != "ok") { println(json_stringify(loaded)); exit(1); }
function fail(msg, obj) { println(msg, json_stringify(obj)); delete_file("tut-bootstrap.npz"); exit(1); }
arr = pycli.frame_to_array({frame: "tut-bootstrap.npz", columns: ["value"], squeeze: true});
if (arr.status != "ok" || arr.result.status != "OK") { fail("frame_to_array:", arr); }
x = arr.result.values; n = len(x);
mean = 0; for (v in x) { mean = mean + v; } mean = mean / n;
ss = 0; for (v in x) { ss = ss + (v - mean) * (v - mean); }
sd = sqrt(ss / (n - 1)); se = sd / sqrt(n);
println(sprintf("sample: n=%d mean=%.4f sd=%.4f se=%.4f", n, mean, sd, se));

// Bootstrap: B resamples of n indices each. Inline calls return at most 1000 uniforms, so each uniform u (53 random bits) supplies
// two indices: floor(n u) and floor(n frac(n u)); one explicit seed per call makes the whole stream reproducible.
draws = []; seed = 1; hit = [];
for (i = 0; i < n; i = i + 1) { hit = concat(hit, [0]); }
while (len(draws) < B * n) {
  u = pycli.stats_dist({dist: "uniform", "fn": "rvs", params: {"low": 0, "high": 1}, n: 1000, seed: seed});
  if (u.status != "ok" || u.result.status != "OK") { fail("uniform draws:", u); }
  for (v in u.result.values) { w = v * n; draws = concat(draws, [floor(w), floor((w - floor(w)) * n)]); }
  seed = seed + 1;
}
boot = [];
for (b = 0; b < B; b = b + 1) {
  total = 0;
  for (i = 0; i < n; i = i + 1) { idx = draws[b * n + i]; total = total + x[idx]; hit[idx] = hit[idx] + 1; }
  boot = concat(boot, [total / n]);
}
bmean = 0; for (v in boot) { bmean = bmean + v; } bmean = bmean / B;
bss = 0; for (v in boot) { bss = bss + (v - bmean) * (v - bmean); }
bse = sqrt(bss / (B - 1));
sorted = sort(boot);
lo = sorted[floor(0.025 * B)]; hi = sorted[ceil(0.975 * B) - 1];
println(sprintf("bootstrap (B=%d, seeds 1..%d): mean of means=%.4f SE=%.4f percentile 95%% CI=[%.4f, %.4f]", B, seed - 1, bmean, bse, lo, hi));

// Normal-theory interval with the t quantile, and the generating distribution's moments for reference.
q = pycli.stats_dist({dist: "t", "fn": "ppf", params: {df: n - 1}, x: [0.975]});
if (q.status != "ok" || q.result.status != "OK") { fail("t quantile:", q); }
tq = q.result.values[0];
println(sprintf("t interval: [%.4f, %.4f] (t=%.4f on %d df)", mean - tq * se, mean + tq * se, tq, n - 1));
m = pycli.stats_dist({dist: "gamma", "fn": "moments", params: {shape: 2, scale: 5}});
if (m.status != "ok" || m.result.status != "OK") { fail("gamma moments:", m); }
println("generating gamma(2, 5) moments:", json_stringify(m.result.moments));

// Self-checks. Every row is resampled (each index is drawn about B = 1000 times; a resampler that skips rows fails here); the
// bootstrap mean of a mean is unbiased, and with B = 1000 its own standard error is se / sqrt(B) = 0.03 se, so 0.25 se is a 8-sigma
// bound that still fails for a resampler drawing from the wrong rows; the bootstrap SE of a mean equals s / sqrt(n) up to the
// (n-1)/n factor and the B-resample noise (about 1 / sqrt(2B) = 2.2%), so 15% catches a wrong-rows resampler (the reviewer's
// 30-of-40 mutation moved it by 6%, and loses the coverage check first); the percentile interval covers the true mean 10 and is
// about as wide as the t interval (ratio in [0.8, 1.2]).
missed = 0; for (i = 0; i < n; i = i + 1) { if (hit[i] == 0) { missed = missed + 1; } }
if (missed > 0) { fail("rows never drawn by the resampler:", missed); }
if (abs(bse - se) > 0.15 * se) { fail("bootstrap SE more than 15% from s/sqrt(n):", {bse: bse, se: se}); }
if (abs(bmean - mean) > 0.25 * se) { fail("bootstrap mean more than 0.25 SE from the sample mean:", {bmean: bmean, mean: mean}); }
if (lo > 10 || hi < 10) { fail("percentile interval misses the true mean 10:", [lo, hi]); }
ratio = (hi - lo) / (2 * tq * se);
if (ratio < 0.8 || ratio > 1.2) { fail("interval width ratio outside [0.8, 1.2]:", ratio); }
delete_file("tut-bootstrap.npz");
println(sprintf("Checks passed: all %d rows drawn, bootstrap mean within 0.25 SE, bootstrap SE %.4f vs %.4f (15%%), width ratio %.3f, interval covers the true mean.", n, bse, se, ratio));
