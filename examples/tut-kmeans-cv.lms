// access: write
// Topic: clustering and classification with cross-validation on an iris-style table (after: the scikit-learn user guide's
//   k-means and cross-validation sections and the classic iris tutorial)
// What it does: clusters the petal measurements with k-means (ml_fit, fixed seed), labels every row with the saved model
//   (ml_predict), measures cluster purity against the species, runs a stratified 5-fold cross-validation of a k-nearest-neighbours
//   classifier on all four measurements (ml_cv), fits a logistic classifier and scores its predictions with ml_metrics (confusion
//   matrix, accuracy, macro F1), and checks purity >= 0.9 with one cluster per species, CV accuracy >= 0.9 and training accuracy >= 0.95.
// Data: examples/data/tut-flowers.csv, 150 rows: three species, 50 each, four normal measurements around species means (seed 113).
// Usage: export PATH=/path/to/pycli/bin:$PATH; lmscript examples/tut-kmeans-cv.lms   (writes and removes tut-flowers*.npz / .safetensors in cwd)
import "../cli.schema.dev.json" as pycli;

files = ["tut-flowers.npz", "tut-flowers-kmeans.safetensors", "tut-flowers-clusters.npz", "tut-flowers-logit.safetensors", "tut-flowers-pred.npz"];
function cleanup() { for (p in files) { if (file_exists(p)) { delete_file(p); } } }
function fail(msg, obj) { println(msg, json_stringify(obj)); cleanup(); exit(1); }
cleanup();   // a stale file from an interrupted run would be a CONFLICT
loaded = pycli.frame_import({csv: "examples/data/tut-flowers.csv", out: "tut-flowers.npz"});
if (loaded.status == "simulated") { println("Clustering simulated."); exit(0); }
if (loaded.status != "ok") { fail("frame_import:", loaded); }
species = ["setosa", "versicolor", "virginica"];
all = pycli.frame_inspect({frame: "tut-flowers.npz", head: 150});
if (all.status != "ok") { fail("frame_inspect:", all); }
truth = all.result.head.data.species; n = len(truth);

// 1. k-means on the two petal measurements, then label every row with the saved model.
km = pycli.ml_fit({frame: "tut-flowers.npz", family: "kmeans", features: ["petal_length", "petal_width"], params: {n_clusters: 3}, preprocess: {scale: false, one_hot: []}, seed: 7, out: "tut-flowers-kmeans.safetensors"});
if (km.status != "ok" || km.result.status != "OK") { fail("ml_fit kmeans:", km); }
println("k-means centres (petal_length, petal_width):", json_stringify(km.result.parameters.cluster_centers_));
lab = pycli.ml_predict({frame: "tut-flowers.npz", model: "tut-flowers-kmeans.safetensors", kind: "predict", out: "tut-flowers-clusters.npz"});
if (lab.status != "ok" || lab.result.status != "OK") { fail("ml_predict kmeans:", lab); }
cl = pycli.frame_to_array({frame: "tut-flowers-clusters.npz", columns: ["prediction"], squeeze: true});
if (cl.status != "ok") { fail("frame_to_array:", cl); }
clusters = cl.result.values;
table = [[0, 0, 0], [0, 0, 0], [0, 0, 0]];   // rows species, columns cluster
for (i = 0; i < n; i = i + 1) { s = index_of(species, truth[i]); table[s][clusters[i]] = table[s][clusters[i]] + 1; }
println("species x cluster:", json_stringify(table));
agree = 0; used = [];
for (s = 0; s < 3; s = s + 1) {
  best = 0; for (c = 1; c < 3; c = c + 1) { if (table[s][c] > table[s][best]) { best = c; } }
  agree = agree + table[s][best]; used = concat(used, [best]);
}
purity = agree / n;
println(sprintf("cluster purity (majority cluster per species): %.3f; species -> cluster %s", purity, json_stringify(used)));

// 2. Stratified 5-fold cross-validation of a 5-nearest-neighbours classifier on all four measurements (scaled per fold).
cv = pycli.ml_cv({frame: "tut-flowers.npz", family: "knn_classifier", features: ["sepal_length", "sepal_width", "petal_length", "petal_width"], target: "species", params: {n_neighbors: 5}, preprocess: {scale: true, one_hot: []}, cv: "stratified", n_splits: 5, shuffle: true, seed: 11, metrics: ["accuracy", "f1_macro"]});
if (cv.status != "ok" || cv.result.status != "OK") { fail("ml_cv:", cv); }
println(sprintf("5-fold kNN: accuracy %.3f (sd %.3f), macro F1 %.3f", cv.result.mean.accuracy, cv.result.std.accuracy, cv.result.mean.f1_macro));
for (f in cv.result.folds) { println(sprintf("  fold %d: train %d test %d accuracy %.3f", f.fold, f.train_rows, f.test_rows, f.scores.accuracy)); }

// 3. A logistic classifier, its training predictions and the metrics computed by ml_metrics on integer-coded labels.
lg = pycli.ml_fit({frame: "tut-flowers.npz", family: "logistic", features: ["sepal_length", "sepal_width", "petal_length", "petal_width"], target: "species", preprocess: {scale: true, one_hot: []}, seed: 5, out: "tut-flowers-logit.safetensors"});
if (lg.status != "ok" || lg.result.status != "OK") { fail("ml_fit logistic:", lg); }
pr = pycli.ml_predict({frame: "tut-flowers.npz", model: "tut-flowers-logit.safetensors", kind: "predict", out: "tut-flowers-pred.npz"});
if (pr.status != "ok" || pr.result.status != "OK") { fail("ml_predict logistic:", pr); }
pv = pycli.frame_inspect({frame: "tut-flowers-pred.npz", head: 150});
if (pv.status != "ok") { fail("frame_inspect prediction:", pv); }
y_true = []; y_pred = [];
for (i = 0; i < n; i = i + 1) { y_true = concat(y_true, [index_of(species, truth[i])]); y_pred = concat(y_pred, [index_of(species, pv.result.head.data.prediction[i])]); }
mt = pycli.ml_metrics({metrics: ["confusion_matrix", "accuracy", "f1"], average: "macro", y_true: y_true, y_pred: y_pred});
if (mt.status != "ok" || mt.result.status != "OK") { fail("ml_metrics:", mt); }
println(sprintf("logistic training accuracy %.3f, macro F1 %.3f; confusion matrix %s (rows true, columns predicted, %s)", mt.result.metrics.accuracy, mt.result.metrics.f1, json_stringify(mt.result.confusion_matrix), json_stringify(species)));

// Self-checks.
if (purity < 0.9) { fail("k-means purity below 0.9:", purity); }
if (used[0] == used[1] || used[0] == used[2] || used[1] == used[2]) { fail("two species share a majority cluster:", used); }
if (cv.result.completed_folds != 5 || cv.result.mean.accuracy < 0.9) { fail("cross-validated accuracy below 0.9:", cv.result.mean); }
if (mt.result.metrics.accuracy < 0.95 || mt.result.n != n) { fail("training accuracy below 0.95:", mt.result); }
// The confusion matrix diagonal reproduces the accuracy.
diag = 0; for (i = 0; i < 3; i = i + 1) { diag = diag + mt.result.confusion_matrix[i][i]; }
if (abs(diag / n - mt.result.metrics.accuracy) > 0.000000001) { fail("confusion matrix diagonal does not match the accuracy:", mt.result); }
cleanup();
println(sprintf("Checks passed: purity %.3f, CV accuracy %.3f, training accuracy %.3f.", purity, cv.result.mean.accuracy, mt.result.metrics.accuracy));
