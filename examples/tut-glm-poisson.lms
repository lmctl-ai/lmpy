// access: read
// Topic: Poisson regression for counts with an exposure offset (after: the R ?glm help page and the statsmodels GLM notebook)
// What it does: fits count ~ group with log(hours) as the exposure by sm_glm (poisson, log link), prints rate ratios with
//   intervals, compares the deviance drop against the chi-square reference with stats_dist, and checks the estimated group
//   rate ratios against the values the data were generated with.
// Data: examples/data/tut-poisson.csv, 90 rows (30 per group A/B/C): count ~ Poisson(2 * exp(0.5 [B] - 0.4 [C]) * hours), seed 102.
// Usage: export PATH=/path/to/pycli/bin:$PATH; lmscript examples/tut-glm-poisson.lms
import "../cli.schema.dev.json" as pycli;

E = 2.718281828459045;
truth = {const: 0.6931471805599453, "group[T.B]": 0.5, "group[T.C]": -0.4};
fit = pycli.sm_glm({csv: "examples/data/tut-poisson.csv", y: "count", terms: [{cat: "group", ref: "A"}], family: "poisson", link: "log", exposure: "hours"});
if (fit.status == "simulated") { println("GLM simulated."); exit(0); }
if (fit.status != "ok" || fit.result.status != "OK") { println("sm_glm failed:", json_stringify(fit)); exit(1); }
r = fit.result; c = r.coefficients;
println(sprintf("poisson/log, n=%d, converged=%s in %d IRLS steps; deviance=%.3f on %d df (null %.3f), AIC=%.2f", r.n_obs, str(r.converged), r.n_iter, r.deviance, r.df_resid, r.null_deviance, r.aic));
println("term          coef     se      rate ratio  [95% CI]");
for (i = 0; i < len(c.names); i = i + 1) {
  println(sprintf("%-12s %7.4f %7.4f   %6.3f  [%.3f, %.3f]", c.names[i], c.estimate[i], c.std_err[i], pow(E, c.estimate[i]), pow(E, c.ci_lower[i]), pow(E, c.ci_upper[i])));
}

// Self-check 1: each estimate is within 2 standard errors of the generating value (log scale; this fixture sits at 0.3, 0.5 and 1.4
// SE, so a generating B effect of 0.75 instead of 0.5, 2.2 SE away, fails), and the fitted coefficients are pinned to 1e-4 as a
// tool-regression check (const 0.6725, group[T.B] 0.5481, group[T.C] -0.2436 on this table).
pinned = [0.67251, 0.54809, -0.24359];
for (i = 0; i < len(c.names); i = i + 1) {
  if (abs(c.estimate[i] - truth[c.names[i]]) > 2 * c.std_err[i]) { println("estimate for", c.names[i], "is more than 2 SE from the truth"); exit(1); }
  if (abs(c.estimate[i] - pinned[i]) > 0.0001) { println("estimate for", c.names[i], "differs from the pinned fixture value", pinned[i]); exit(1); }
}
// Self-check 2: the deviance drop from the null model, referred to chi-square(df_model), rejects "no group effect".
drop = r.null_deviance - r.deviance;
p = pycli.stats_dist({dist: "chi2", "fn": "sf", params: {df: r.df_model}, x: [drop]});
if (p.status != "ok" || p.result.status != "OK") { println(json_stringify(p)); exit(1); }
println(sprintf("likelihood-ratio test of the group effect: deviance drop %.3f on %d df, p = %.5f", drop, r.df_model, p.result.values[0]));
if (p.result.values[0] > 0.01) { println("the group effect should be detectable at the 1% level with this fixture"); exit(1); }
// Self-check 3: residual deviance is on the scale of its degrees of freedom (no gross overdispersion in Poisson data).
if (r.deviance / r.df_resid > 1.6 || r.deviance / r.df_resid < 0.5) { println("deviance / df_resid outside [0.5, 1.6]:", r.deviance / r.df_resid); exit(1); }
println("Checks passed: estimates within 2 SE of the truth and at their pinned values, group effect significant, dispersion near 1.");
